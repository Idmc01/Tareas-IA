# .gitignore for Tareas-IA
# Prevent committing large/generated files while keeping small important files tracked.
# If you want to keep an otherwise-empty directory under version control, add a
# placeholder file inside it (e.g. .gitkeep) and commit that file.

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/


# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs and temp
*.log
*.tmp
*.bak
*.swp

# Archives / packages
*.zip
*.tar
*.tar.gz
*.gz
*.egg-info/

# Compiled extensions
*.so
*.dylib
*.dll

# Data / generated artifacts (adjust if you want to track any of these)
# These are typically large or regenerated by preprocessing/training.
spectrograms_224/
spectrograms_split_224/
ESC-50-organized/


# Model checkpoints / numpy arrays (large binaries)
*.pth
*.pt
*.ckpt
*.h5
*.npy
*.npz

# Tensorboard / logs
runs/
tb_logs/

# Keep .gitkeep files if present (use them to preserve empty folders)
!.gitkeep

# Optional: if you DO want to version audio/ or meta/ directories, remove or comment out the lines above
# that ignore spectrograms_224/ or ESC-50-organized/ etc. Be careful with large data.

# Note: Git does not track empty folders. To prevent accidental deletion of an important
# directory that may be empty on some machines, place a file named `.gitkeep` (or README) inside
# and commit that file. Example to add .gitkeep to a folder:
#   New-Item -Path .\spectrograms_split_224\train -ItemType Directory -Force; New-Item .\spectrograms_split_224\train\.gitkeep -ItemType File
