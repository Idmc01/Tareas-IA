# .gitignore for Tareas-IA
# Prevent committing large/generated files while keeping small important files tracked.
# If you want to keep an otherwise-empty directory under version control, add a
# placeholder file inside it (e.g. .gitkeep) and commit that file.

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/


# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs and temp
*.log
*.tmp
*.bak
*.swp

# Archives / packages
*.zip
*.tar
*.tar.gz
*.gz
*.egg-info/

# Compiled extensions
*.so
*.dylib
*.dll

# Data / generated artifacts (adjust if you want to track any of these)
# These are typically large or regenerated by preprocessing/training.
spectrograms_224/
spectrograms_split_224/
ESC-50-organized/


# Model checkpoints / numpy arrays (large binaries)
*.pth
*.pt
*.ckpt
*.h5
*.npy
*.npz

# Tensorboard / logs
runs/
tb_logs/

# Keep .gitkeep files if present (use them to preserve empty folders)
!.gitkeep

